limit_req_zone $binary_remote_addr zone=vidleaf_api:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name api.example.com;

    # Configure TLS certificates here. Do not expose /var/lib/vidleaf publicly.
    client_max_body_size 16k;

    location /api/ {
        limit_req zone=vidleaf_api burst=10 nodelay;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off; # required for prompt SSE forwarding
        proxy_read_timeout 3600s;
    }

    location = /health/live { proxy_pass http://api:8000; }
    location = /health/ready { proxy_pass http://api:8000; }
}
