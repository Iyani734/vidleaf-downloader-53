# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080"]
# redis for production/RQ workers, local for single-process development.
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=vidleaf
DATA_DIR=/var/lib/vidleaf

# Security: generate a long random value for every deployed environment.
DOWNLOAD_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SECURE_COOKIES=false
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384

# Limits and lifetime
ANALYSIS_CACHE_SECONDS=600
JOB_EXPIRY_SECONDS=3600
EXPIRED_RECORD_RETENTION_SECONDS=300
DOWNLOAD_TOKEN_SECONDS=300
MAXIMUM_DURATION_SECONDS=14400
MAXIMUM_FILE_SIZE_BYTES=10737418240
MINIMUM_FREE_DISK_BYTES=3221225472
WORKER_JOB_TIMEOUT_SECONDS=14400
PROVIDER_SOCKET_TIMEOUT_SECONDS=30
YOUTUBE_PLAYER_CLIENTS=["android","web_safari"]
# Optional: exported Netscape-format cookies.txt for public YouTube formats that require browser verification.
YOUTUBE_COOKIES_FILE=
FFMPEG_TIMEOUT_SECONDS=3600

# Set STORAGE_BACKEND=s3 for production object storage. Keep buckets private.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
